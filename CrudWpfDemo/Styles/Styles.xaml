<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  Design System & Colors (Modern Premium Slate/Indigo Theme)  -->
    <!-- ============================================================ -->

    <!-- HSL-curated color palette tokens -->
    <Color x:Key="ColorPrimaire">#4F46E5</Color>      <!-- Indigo 600 -->
    <Color x:Key="ColorPrimaireFonce">#3730A3</Color> <!-- Indigo 800 -->
    <Color x:Key="ColorSuccess">#10B981</Color>       <!-- Emerald 500 -->
    <Color x:Key="ColorSuccessFonce">#047857</Color>  <!-- Emerald 700 -->
    <Color x:Key="ColorDanger">#EF4444</Color>        <!-- Rose 500 -->
    <Color x:Key="ColorDangerFonce">#B91C1C</Color>   <!-- Rose 700 -->
    <Color x:Key="ColorSidebar">#0F172A</Color>      <!-- Slate 900 -->
    <Color x:Key="ColorFond">#F8FAFC</Color>         <!-- Slate 50 -->
    <Color x:Key="ColorBordure">#E2E8F0</Color>       <!-- Slate 200 -->
    <Color x:Key="ColorTexteSombre">#1E293B</Color>   <!-- Slate 800 -->
    <Color x:Key="ColorTexteMute">#64748B</Color>     <!-- Slate 500 -->

    <SolidColorBrush x:Key="BrushPrimaire" Color="{StaticResource ColorPrimaire}" />
    <SolidColorBrush x:Key="BrushPrimaireFonce" Color="{StaticResource ColorPrimaireFonce}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSuccessFonce" Color="{StaticResource ColorSuccessFonce}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerFonce" Color="{StaticResource ColorDangerFonce}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushFond" Color="{StaticResource ColorFond}" />
    <SolidColorBrush x:Key="BrushBordure" Color="{StaticResource ColorBordure}" />
    <SolidColorBrush x:Key="BrushTexteSombre" Color="{StaticResource ColorTexteSombre}" />
    <SolidColorBrush x:Key="BrushTexteMute" Color="{StaticResource ColorTexteMute}" />

    <!-- Typography -->
    <FontFamily x:Key="PoliceApp">Segoe UI</FontFamily>

    <!-- Base Window Style -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource PoliceApp}" />
        <Setter Property="Background" Value="{StaticResource BrushFond}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Titles & Labels -->
    <Style x:Key="TitrePage" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexteSombre}" />
        <Setter Property="Margin" Value="0,0,0,15" />
    </Style>

    <Style x:Key="Libelle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexteSombre}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Form Inputs (TextBox) -->
    <Style x:Key="ChampSaisie" TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaire}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox styling -->
    <Style x:Key="SelectionCombo" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaire}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Buttons -->
    <Style x:Key="BoutonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                             CornerRadius="5"
                             Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonPrimaire" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource BrushPrimaire}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimaireFonce}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonSuccess" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSuccessFonce}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerFonce}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Sidebar Navigation Menu Buttons -->
    <Style x:Key="BoutonMenu" TargetType="Button">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" /> <!-- Slate 400 -->
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                             CornerRadius="6"
                             Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1E293B" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonMenuActive" TargetType="Button" BasedOn="{StaticResource BoutonMenu}">
        <Setter Property="Background" Value="#4F46E5" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4338CA" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Custom Styling -->
    <Style x:Key="GrilleDonnees" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Style.Resources>
            <!-- Column Header style -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTexteSombre}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
            </Style>
            <!-- Cell Style -->
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#EEF2FF"/> <!-- Indigo 50 -->
                        <Setter Property="Foreground" Value="{StaticResource BrushPrimaire}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>

</ResourceDictionary>
